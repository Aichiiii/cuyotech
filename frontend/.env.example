# Copy this file to ".env" and adjust if needed.

# Where the PHP backend runs (used by the Vite dev-server proxy)
#   PHP built-in server:  http://localhost:8000
#   XAMPP:                http://localhost/cuyotech-ssis/backend
VITE_API_TARGET=http://localhost:8000

# Only for production builds served from a sub-folder, e.g. /cuyotech-ssis/frontend/dist/
# VITE_BASE_PATH=/
# VITE_API_BASE=/cuyotech-ssis/backend/api
